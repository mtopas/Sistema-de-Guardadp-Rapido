# Copiá este archivo a .env y completá los valores.
# cp .env.example .env
#
# Los campos sin valor por defecto son obligatorios para que esa funcionalidad ande.

# ── Bot de Telegram ────────────────────────────────────────────────────────────
# Obtené el token en @BotFather. Obligatorio para usar el bot.
TELEGRAM_BOT_TOKEN=

# Chat IDs habilitados para usar el bot (separados por coma).
# Si está vacío, cualquier chat puede interactuar. Recomendado: completar con tu chat_id.
# BOT_ALLOWED_CHAT_IDS=123456789

# Red hacia api.telegram.org (Docker homelab). -1 = reintentar bootstrap sin abortar.
# TELEGRAM_BOOTSTRAP_RETRIES=-1
# TELEGRAM_CONNECT_TIMEOUT=30
# TELEGRAM_READ_TIMEOUT=30
# Si Telegram está bloqueado en tu red: socks5://host:port o http://host:port
# TELEGRAM_PROXY_URL=

# Modo /dev en el bot: nivel de log local al activar dev (DEBUG|INFO|WARNING).
# BOT_DEV_LOG_LEVEL=INFO

# ── API SGR ────────────────────────────────────────────────────────────────────
# URL base que usa el bot para llamar al backend.
# Debe ser la MISMA instancia que abrís en el navegador (.exe / uvicorn / Docker).
#
# Dev local (bot y API en la PC):
API_BASE_URL=http://127.0.0.1:8765
#
# Docker homelab — bot con network_mode: host (Telegram/Ollama vía red Ubuntu).
# La API local del bot es el puerto publicado del backend:
# API_BASE_URL=http://127.0.0.1:8765
# Ollama en Windows (ICS): OLLAMA_BASE_URL=http://192.168.137.1:11434

# Puerto donde corre uvicorn / SGR.exe.
# Cambiarlo acá y en el comando de arranque si el 8765 está ocupado.
# SGR_PORT=8765

# Host donde escucha el backend. Usar 0.0.0.0 para exponer en red local.
# SGR_HOST=127.0.0.1

# ── Datos ──────────────────────────────────────────────────────────────────────
# Ruta al directorio de datos (database/ y uploads/ quedan dentro).
# Por defecto se resuelve relativo a project/.
# SGR_DATA_DIR=

# Ruta directa al archivo SQLite. Override de SGR_DATA_DIR para la DB.
# DB_PATH=

# ── Sync homelab ↔ .exe (opcional) ────────────────────────────────────────────
# Si se define HOMELAB_HOST, SGR.exe sincroniza la DB automáticamente al abrir
# (pull) y ofrece subir cambios al cerrar (push), sin parar Docker.
# Requiere que el backend del homelab esté corriendo (docker-compose.yml).
#
# IP o hostname del homelab. Dejar vacío para deshabilitar el sync.
# HOMELAB_HOST=192.168.137.10
#
# Puerto de la API en el homelab. Por defecto igual a SGR_PORT (8765).
# HOMELAB_PORT=8765
#
# Token de seguridad para los endpoints /sync/export y /sync/import.
# Debe coincidir con SGR_SYNC_TOKEN en el .env del homelab (si se configuró).
# SGR_SYNC_TOKEN=

# ── Debug ──────────────────────────────────────────────────────────────────────
# Activar logs detallados del backend. Valores: 1 | true | yes
# SGR_DEBUG=0

# ── Ollama / LLM ───────────────────────────────────────────────────────────────
# URL base del servicio Ollama.
# Dev local (Ollama en la misma PC que el bot): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
#
# Homelab Docker: NO uses localhost en .env — compose fija http://192.168.137.1:11434
# (Ollama en Windows vía ICS). En Windows: OLLAMA_HOST=0.0.0.0:11434

# Modelo para clasificación de intención y extracción de datos (JSON estructurado).
OLLAMA_MODEL_CLASSIFY=llama3.2:3b

# Modelo para respuestas conversacionales (consultas, informes, RAG).
OLLAMA_MODEL_CHAT=llama3.2:3b

# Modelo de embeddings para búsqueda semántica en Bóveda.
OLLAMA_MODEL_EMBED=nomic-embed-text

# Timeout en segundos para inferencia (classify/chat). Homelab→Windows CPU: 60–90.
OLLAMA_TIMEOUT=60
# Solo arranque: precarga del modelo (cold start). Homelab: 120–180.
# OLLAMA_WARMUP_TIMEOUT=180

# Umbral de confianza del clasificador: >= 0.75 acción directa, 0.5–0.75 pide confirmación.
LLM_CONFIDENCE_THRESHOLD=0.75
