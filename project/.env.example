# Copiá este archivo a .env y completá los valores.
# cp .env.example .env
#
# Los campos sin valor por defecto son obligatorios para que esa funcionalidad ande.

# ── Bot de Telegram ────────────────────────────────────────────────────────────
# Obtené el token en @BotFather. Obligatorio para usar el bot.
TELEGRAM_BOT_TOKEN=

# Chat IDs habilitados para usar el bot (separados por coma).
# Si está vacío, cualquier chat puede interactuar. Recomendado: completar con tu chat_id.
# BOT_ALLOWED_CHAT_IDS=123456789

# ── API SGR ────────────────────────────────────────────────────────────────────
# URL base que usa el bot para llamar al backend.
# En dev local no hace falta cambiarlo.
API_BASE_URL=http://127.0.0.1:8765

# Puerto donde corre uvicorn / SGR.exe.
# Cambiarlo acá y en el comando de arranque si el 8765 está ocupado.
# SGR_PORT=8765

# Host donde escucha el backend. Usar 0.0.0.0 para exponer en red local.
# SGR_HOST=127.0.0.1

# ── Datos ──────────────────────────────────────────────────────────────────────
# Ruta al directorio de datos (database/ y uploads/ quedan dentro).
# Por defecto se resuelve relativo a project/.
# SGR_DATA_DIR=

# Ruta directa al archivo SQLite. Override de SGR_DATA_DIR para la DB.
# DB_PATH=

# ── Debug ──────────────────────────────────────────────────────────────────────
# Activar logs detallados del backend. Valores: 1 | true | yes
# SGR_DEBUG=0
