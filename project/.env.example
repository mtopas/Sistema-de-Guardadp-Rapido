# Copiá a .env y completá lo que uses.
# API SGR — puerto 8765 por defecto (no 8000; evita conflicto con SimLab u otros)

TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8765

# Opcional: mismo puerto que usa uvicorn / SGR.exe
# SGR_PORT=8765
# SGR_HOST=127.0.0.1

# Bot: restringir chats (vacío = todos)
# BOT_ALLOWED_CHAT_IDS=123456789

# Datos (override manual)
# SGR_DATA_DIR=
# DB_PATH=
