# Base de la API. Vacío = usa el proxy de Vite (/api → http://127.0.0.1:8765).
# Solo hace falta tocarlo si querés apuntar directo a otro host (p. ej. el homelab por Tailscale).
VITE_API_URL=

# Solo para `npm run dev`: a dónde apunta el proxy y en qué puerto levanta la UI.
SGR_API=http://127.0.0.1:8765
SGR_UI_PORT=5273
