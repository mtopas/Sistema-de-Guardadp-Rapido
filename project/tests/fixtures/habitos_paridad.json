{
  "_readme": "Fixtures compartidos para los tests de paridad de hábitos (frontend habitosUtils.js, backend app/db/crud.py, bot mybot/agenda_handlers.py). 'today' está fijo en 2026-09-23 (miércoles) para que los tres lados calculen sobre el mismo 'hoy' -- mismo valor que ya usa project/frontend/src/components/habitos/habitos.test.js vía vi.setSystemTime. Los valores 'expected_*' fueron precalculados a mano (ver script de simulación de la sesión que los generó) replicando el algoritmo exacto de cada lado -- cuando los tres coinciden se usa 'expected' único; cuando divergen, se listan expected_frontend/expected_backend/expected_bot por separado y se documenta en 'note'. dias_semana va como string JSON (o null), igual que en la DB real -- las tres implementaciones esperan ese formato, no una lista cruda.",

  "today": "2026-09-23",

  "schedule_cases": [
    {
      "name": "diario_activo",
      "habito": { "frecuencia_tipo": "diario", "dias_semana": null, "activo": true },
      "expected": {
        "2026-09-20": true, "2026-09-21": true, "2026-09-22": true, "2026-09-23": true,
        "2026-09-24": true, "2026-09-25": true, "2026-09-26": true
      }
    },
    {
      "name": "diario_inactivo",
      "habito": { "frecuencia_tipo": "diario", "dias_semana": null, "activo": false },
      "expected": {
        "2026-09-20": false, "2026-09-21": false, "2026-09-22": false, "2026-09-23": false,
        "2026-09-24": false, "2026-09-25": false, "2026-09-26": false
      }
    },
    {
      "name": "semanal_mon_wed",
      "habito": { "frecuencia_tipo": "semanal", "dias_semana": "[1,3]", "activo": true },
      "expected": {
        "2026-09-20": false, "2026-09-21": true, "2026-09-22": false, "2026-09-23": true,
        "2026-09-24": false, "2026-09-25": false, "2026-09-26": false
      }
    },
    {
      "name": "semanal_weekend",
      "habito": { "frecuencia_tipo": "semanal", "dias_semana": "[0,6]", "activo": true },
      "expected": {
        "2026-09-20": true, "2026-09-21": false, "2026-09-22": false, "2026-09-23": false,
        "2026-09-24": false, "2026-09-25": false, "2026-09-26": true
      }
    },
    {
      "name": "semanal_friday",
      "habito": { "frecuencia_tipo": "semanal", "dias_semana": "[5]", "activo": true },
      "expected": {
        "2026-09-20": false, "2026-09-21": false, "2026-09-22": false, "2026-09-23": false,
        "2026-09-24": false, "2026-09-25": true, "2026-09-26": false
      }
    }
  ],

